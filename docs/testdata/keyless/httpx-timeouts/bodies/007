 <div class="Documentation-declaration">
 <pre>type Client struct {
<span id="Client.HTTPDoer" data-kind="field"> <span class="comment">// HTTPDoer specifies the mechanics of sending HTTP requests and</span>
</span> <span class="comment">// receiving responses.</span>
